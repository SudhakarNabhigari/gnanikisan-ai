# GEMINI_API_KEY: Required for Gemini AI reasoning and Crop Doctor vision API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HttpOnly authentication session cookies.
SESSION_SECRET="change_this_to_a_long_random_string"

# GNANI AI (Vachana Prisma STT & Timbre TTS):
# Obtain your API key from the Gnani Vachana developer portal (https://api.vachana.ai).
GNANI_API_KEY=""
GNANI_API_BASE_URL="https://api.vachana.ai"

# DATA.GOV.IN AGMARKNET (Optional live Mandi prices API):
# If omitted, Market Price Today shows clearly labelled non-live demo reference prices.
DATA_GOV_API_KEY=""

# TWILIO VERIFY (Optional real SMS OTP for Indian mobile verification):
# If omitted, Profile mobile verification displays "Verification service not configured".
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# RESEND (Optional real Email OTP for email verification):
# If omitted, Profile email verification displays "Verification service not configured".
RESEND_API_KEY=""
OTP_FROM_EMAIL="noreply@example.com"
